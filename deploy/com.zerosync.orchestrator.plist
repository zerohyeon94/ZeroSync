<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ZeroSync 봇 상시 실행 (SPEC 2.1, 9.3).
  LaunchAgent(로그인 사용자)로 실행한다. CLI 구독 로그인이 사용자 계정에 있기 때문이다.
  __REPO__, __HOME__은 scripts/install_launchd.sh가 채운다. 직접 쓰면 절대 경로로 바꾼다.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zerosync.orchestrator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-is</string>
    <string>__REPO__/.venv/bin/python</string>
    <string>-m</string>
    <string>bot</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd의 PATH에는 Homebrew가 없다. claude, codex, gh, git, xcodebuild를 찾게 한다 -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>ko_KR.UTF-8</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- 비정상 종료 때만 다시 띄운다. 설정 오류(종료 코드 1)로 끝없이 재시작하지 않게 간격을 둔다 -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.zerosync/bot.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.zerosync/bot.err.log</string>
</dict>
</plist>
